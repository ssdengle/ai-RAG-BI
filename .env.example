# Application environment
APP_NAME=ai-business-intelligence-platform
APP_ENV=development
LOG_LEVEL=INFO

# API service
API_HOST=0.0.0.0
API_PORT=8000

# Frontend service
WEB_HOST=0.0.0.0
WEB_PORT=8501
API_BASE_URL=http://api:8000

# Worker service
WORKER_CONCURRENCY=2

# Scheduler service
SCHEDULER_POLL_INTERVAL_SECONDS=60

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_bi_platform
POSTGRES_USER=ai_bi_user
POSTGRES_PASSWORD=change-me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
