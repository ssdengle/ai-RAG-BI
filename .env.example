# Application environment
APP_NAME=ai-business-intelligence-platform
APP_ENV=development

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
LOG_SERVICE_NAME=api

# API service
API_HOST=0.0.0.0
API_PORT=8000

# Frontend service
WEB_HOST=0.0.0.0
WEB_PORT=8501
API_BASE_URL=http://api:8000

# Worker service
WORKER_CONCURRENCY=2

# Scheduler service
SCHEDULER_POLL_INTERVAL_SECONDS=60

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_bi_platform
POSTGRES_USER=ai_bi_user
POSTGRES_PASSWORD=change-me
POSTGRES_ECHO=false
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_CONNECT_TIMEOUT_SECONDS=5

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_DIMENSIONS=1536
LLM_EMBEDDING_BATCH_SIZE=32
LLM_EMBEDDING_MAX_RETRIES=3
