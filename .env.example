# Application environment
APP_NAME=ai-business-intelligence-platform
APP_ENV=development

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
LOG_SERVICE_NAME=api

# API service
API_HOST=0.0.0.0
API_PORT=8000

# Frontend service
WEB_HOST=0.0.0.0
WEB_PORT=8501
API_BASE_URL=http://api:8000

# Worker service
WORKER_CONCURRENCY=2

# Scheduler service
SCHEDULER_POLL_INTERVAL_SECONDS=60

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_bi_platform
POSTGRES_USER=ai_bi_user
POSTGRES_PASSWORD=change-me
POSTGRES_ECHO=false
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_CONNECT_TIMEOUT_SECONDS=5

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_DIMENSIONS=1536
LLM_EMBEDDING_BATCH_SIZE=32
LLM_EMBEDDING_MAX_RETRIES=3

# Authentication
AUTH_ENABLED=true
AUTH_JWT_SECRET=change-me-jwt-secret
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_USERS=admin:change-me:admin,analyst:change-me:analyst,reviewer:change-me:reviewer,viewer:change-me:viewer
AUTH_API_KEYS=admin-key:admin:admin,analyst-key:analyst:analyst,reviewer-key:reviewer:reviewer,viewer-key:viewer:viewer

# Security
SECURITY_CORS_ORIGINS=*
SECURITY_CORS_ALLOW_CREDENTIALS=true
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE_SECONDS=31536000
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_REQUESTS=120
SECURITY_RATE_LIMIT_WINDOW_SECONDS=60
SECURITY_MAX_REQUEST_BODY_BYTES=1048576
SECURITY_BLOCK_PROMPT_INJECTION=true

# Cache
CACHE_ENABLED=true
CACHE_RETRIEVAL_TTL_SECONDS=900
CACHE_EMBEDDING_TTL_SECONDS=86400
CACHE_QA_TTL_SECONDS=1800
CACHE_WORKFLOW_TTL_SECONDS=3600

# Metrics
METRICS_ENABLED=true
METRICS_PATH=/metrics

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-bi-platform-api
OTEL_SERVICE_VERSION=0.1.0
OTEL_ENVIRONMENT=development
OTEL_CONSOLE_EXPORTER=false
